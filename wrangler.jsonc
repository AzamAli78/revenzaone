{
  // Cloudflare Workers config. "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "revenza-one-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // Runs before every deploy, so Cloudflare builds dist/ itself.
  "build": { "command": "node build.mjs" },
  // Cloudflare attaches these domains (DNS records + HTTPS) on every deploy.
  "routes": [
    { "pattern": "revenzaone.site", "custom_domain": true },
    { "pattern": "www.revenzaone.site", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
