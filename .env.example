# Copy to .env for local use (never commit .env). On Vercel, add these under Project Settings > Environment Variables.

# Your real public domain, used for canonical URLs, sitemap and Open Graph (build time)
SITE_URL=https://revenzaone.site

# Contact form email delivery via Resend (https://resend.com), used by api/contact.js
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@your-domain.com
# Must be an address on a domain you verified in Resend, e.g. "Revenza One <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
